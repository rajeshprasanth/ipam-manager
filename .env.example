# Copy to .env and edit for your environment.
# NEVER commit a real .env file to version control.

APP_NAME=IPAM Manager
APP_VERSION=1.0.0
DEBUG=false

# Owner / copyright shown in portal footers.
# Leave COPYRIGHT empty to auto-generate "Copyright © <year> <APP_OWNER>".
APP_OWNER=IPAM Manager Team
COPYRIGHT=Copyright © 2026 IPAM Manager Team

# Generate a strong random value:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL is the recommended production database.
# --------------------------------------------------------------------------
# DATABASE_URL is OPTIONAL. When it is NOT set, the app auto-detects the host:
#   - inside a Docker network  -> uses the `db` service
#   - on the host / VM         -> uses localhost
# Credentials default to POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (or ipam / ipam / ipam).
#
# Set DATABASE_URL explicitly to override auto-detection:
#   docker compose -f Docker/docker-compose.yml up -d db
#   DATABASE_URL=postgresql+psycopg2://ipam:ipam@localhost:5432/ipam
# --------------------------------------------------------------------------

# Cookie hardening (set COOKIE_SECURE=true when serving over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Optional OAuth / social sign-in ---------------------------------------
# A provider is enabled only when BOTH id and secret are set.
# OAuth-created accounts default to the "viewer" role (promote from /users).
#
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: <PUBLIC_BASE_URL>/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Public base URL for OAuth redirect callbacks. Leave empty to derive from
# the Host header; set explicitly behind a proxy / HTTPS:
#   e.g. https://ipam.example.com
OAUTH_BASE_URL=

# Create tables on startup (dev convenience). Use Alembic migrations in production.
AUTO_CREATE_TABLES=true